#!/usr/bin/env python3
# DIGIY PRO DRIVER — découpage mobile sécurisé V4
#
# Usage:
#   python3 apply_driver_mobile_split_v4.py /chemin/vers/digiy-pro-driver
#
# Prérequis:
# - patch session V2 appliqué ;
# - patch profil V3 appliqué ;
# - nouvelles RPC driver_session_* présentes dans Supabase.
#
# Le script :
# - garde profile-edition.html comme atelier de secours ;
# - crée 4 petites pages mobiles indépendantes ;
# - crée une couche API/session commune très courte ;
# - relie le hub aux nouvelles portes ;
# - ne fait aucun commit et aucun push.

from __future__ import annotations

import re
import shutil
import sys
from pathlib import Path


class PatchError(RuntimeError):
    pass


def write_backup(path: Path) -> Path | None:
    if not path.exists():
        return None
    backup = path.with_suffix(path.suffix + ".bak-mobile-split-v4")
    shutil.copy2(path, backup)
    return backup


def replace_once(text: str, old: str, new: str, label: str) -> str:
    count = text.count(old)
    if count != 1:
        raise PatchError(f"{label}: attendu 1 bloc, trouvé {count}")
    return text.replace(old, new, 1)


