def patch_hub(text: str) -> str:
    text = replace_once(text, '<div class="panelHint">6 portes utiles</div>',
                        '<div class="panelHint">8 portes utiles</div>',
                        "hub/panelHint")

    text = replace_once(text,
                        'id="doorProfil" href="./profil-chauffeur.html"',
                        'id="doorProfil" href="./profil-driver.html"',
                        "hub/doorProfil")

    text = replace_once(text,
                        'id="doorTarifs" href="./tarifs-edition.html"',
                        'id="doorTarifs" href="./tarifs-driver.html"',
                        "hub/doorTarifs")

    rates_block = '''        <a class="door pave gold" id="doorTarifs" href="./tarifs-driver.html">
          <div class="paveTop">
            <div class="doorIcon">💰</div>
            <div class="doorTag">Prix</div>
          </div>
          <div class="doorInfo"><b>Mes tarifs</b><span>Grille claire pour le client.</span></div>
        </a>'''

    extra_doors = rates_block + '''

        <a class="door pave" id="doorVisibilite" href="./visibilite-driver.html">
          <div class="paveTop">
            <div class="doorIcon">👁️</div>
            <div class="doorTag">Visible</div>
          </div>
          <div class="doorInfo"><b>Ma visibilité</b><span>Publier ou masquer sans toucher au profil.</span></div>
        </a>

        <a class="door pave" id="doorSession" href="./session-driver.html">
          <div class="paveTop">
            <div class="doorIcon">🔒</div>
            <div class="doorTag">Session</div>
          </div>
          <div class="doorInfo"><b>Ma session</b><span>Vérifier ou fermer l’accès sur cet appareil.</span></div>
        </a>'''

    text = replace_once(text, rates_block, extra_doors, "hub/portes supplémentaires")

    replacements = {
        'profile:   "./profil-chauffeur.html"': 'profile:   "./profil-driver.html"',
        'rates:     "./tarifs-edition.html"': 'rates:     "./tarifs-driver.html"',
        'habitualRoutes: "./profile-edition.html"': 'habitualRoutes: "./tarifs-driver.html"',
        'session:   "./session.html"': 'session:   "./session-driver.html"',
    }
    for old,new in replacements.items():
        text = replace_once(text,old,new,f"hub/routes/{old.split(':')[0].strip()}")

    return text


def main() -> int:
    if len(sys.argv) != 2:
        print("Usage: python3 apply_driver_mobile_split_v4.py /chemin/vers/digiy-pro-driver")
        return 2

    root = Path(sys.argv[1]).expanduser().resolve()
    hub = root / "hub.html"
    monolith = root / "profile-edition.html"

    if not hub.is_file():
        raise PatchError(f"Fichier absent : {hub}")
    if not monolith.is_file():
        raise PatchError(f"Fichier absent : {monolith}")

    monolith_text = monolith.read_text(encoding="utf-8")
    required = [
        'driver_session_get_cockpit',
        'driver_session_save_profile',
        'driver_session_list_rates',
        'driver_session_upsert_rate',
        'driver_session_disable_rate',
    ]
    missing = [name for name in required if name not in monolith_text]
    if missing:
        raise PatchError("Les patchs V2/V3 ne sont pas complets : " + ", ".join(missing))

    targets = {
        root / "assets/css/driver-mobile.css": MOBILE_CSS,
        root / "assets/js/driver-secure-api.js": SECURE_API_JS,
        root / "profil-driver.html": PROFILE_HTML,
        root / "tarifs-driver.html": RATES_HTML,
        root / "visibilite-driver.html": VISIBILITY_HTML,
        root / "session-driver.html": SESSION_HTML,
    }

    hub_original = hub.read_text(encoding="utf-8")
    hub_patched = patch_hub(hub_original)

    # Le monobloc reste disponible, mais son bouton Tarifs rejoint la page courte.
    monolith_patched = monolith_text.replace(
        'tarifs: "./tarifs.html"',
        'tarifs: "./tarifs-driver.html"',
        1
    )

    backup_paths = []
    for path in [hub, monolith, *targets.keys()]:
        b = write_backup(path)
        if b:
            backup_paths.append(b)

    for path, content in targets.items():
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content, encoding="utf-8")

    hub.write_text(hub_patched, encoding="utf-8")
    monolith.write_text(monolith_patched, encoding="utf-8")

    validations = {
        "hub profil mobile": './profil-driver.html' in hub_patched,
        "hub tarifs mobile": './tarifs-driver.html' in hub_patched,
        "hub visibilité": './visibilite-driver.html' in hub_patched,
        "hub session": './session-driver.html' in hub_patched,
        "API cockpit": 'driver_session_get_cockpit' in SECURE_API_JS,
        "API profil": 'driver_session_save_profile' in SECURE_API_JS,
        "API tarifs": 'driver_session_list_rates' in SECURE_API_JS,
        "API révocation": 'driver_revoke_session' in SECURE_API_JS,
    }
    failed = [name for name,ok in validations.items() if not ok]
    if failed:
        raise PatchError("Validation V4 échouée : " + ", ".join(failed))

    print("PATCH MOBILE V4 APPLIQUÉ — aucun commit, aucun push.")
    print("Nouvelles portes :")
    for path in targets:
        print(f"  - {path}")
    print("Fichiers reliés :")
    print(f"  - {hub}")
    print(f"  - {monolith} (atelier de secours conservé)")
    if backup_paths:
        print("Sauvegardes :")
        for path in backup_paths:
            print(f"  - {path}")
    print()
    print("Test : python3 -m http.server 8080")
    print("Puis ouvrir : http://127.0.0.1:8080/hub.html?v=mobile-v4")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except PatchError as exc:
        print(f"ERREUR PATCH MOBILE V4 : {exc}", file=sys.stderr)
        raise SystemExit(1)
