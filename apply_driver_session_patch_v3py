#!/usr/bin/env python3
# DIGIY PRO DRIVER — raccordement cockpit/profil à la session serveur.
#
# À exécuter APRÈS apply_driver_session_patch_v2.py.
#
# Usage:
#   python3 apply_driver_profile_session_patch_v3.py /chemin/vers/digiy-pro-driver
#
# Modifie uniquement profile-edition.html.
# Aucun commit et aucun push.

from __future__ import annotations

import shutil
import sys
from pathlib import Path


class PatchError(RuntimeError):
    pass


def replace_once(text: str, old: str, new: str, label: str) -> str:
    count = text.count(old)
    if count != 1:
        raise PatchError(f"{label}: attendu 1 bloc exact, trouvé {count}")
    return text.replace(old, new, 1)


def main() -> int:
    if len(sys.argv) != 2:
        print("Usage: python3 apply_driver_profile_session_patch_v3.py /chemin/vers/digiy-pro-driver")
        return 2

    root = Path(sys.argv[1]).expanduser().resolve()
    path = root / "profile-edition.html"

    if not path.is_file():
        raise PatchError(f"Fichier absent : {path}")

    text = path.read_text(encoding="utf-8")

    required = [
        'function driverSessionToken()',
        'sb.rpc("driver_session_list_rates"',
        'sb.rpc("driver_session_upsert_rate"',
        'sb.rpc("driver_session_disable_rate"',
    ]
    missing = [item for item in required if item not in text]
    if missing:
        raise PatchError(
            "Le patch V2 n'est pas détecté dans profile-edition.html : "
            + ", ".join(missing)
        )

    old_fetch = '''      async function fetchCockpit(){
        if (!sb) throw new Error("supabase_absent");
        if (!slug) return { ok:false, reason:"slug_manquant" };

        const { data, error } = await sb.rpc("digiy_driver_get_cockpit_by_slug", { p_slug: slug });
        if (error) throw error;
        return data || { ok:false, reason:"empty_response" };
      }'''

    new_fetch = '''      async function fetchCockpit(){
        if (!sb) throw new Error("supabase_absent");

        const token = driverSessionToken();
        if (!token){
          return { ok:false, reason:"invalid_or_expired_session" };
        }

        const { data, error } = await sb.rpc("driver_session_get_cockpit", {
          p_token: token
        });

        if (error) throw error;
        return data || { ok:false, reason:"empty_response" };
      }'''

    text = replace_once(
        text,
        old_fetch,
        new_fetch,
        "profile-edition.html/fetchCockpit",
    )

    old_rpc = '''          const { data, error } = await sb.rpc("digiy_driver_save_profile", {
            p_slug: slug,
            p_business_name: displayName,
            p_driver_name: displayName,
            p_city: city,
            p_zones: zones,
            p_address: bridgeMeta,
            p_whatsapp: whatsapp,
            p_vehicle_type: vehicleType,
            p_vehicle_label: vehicleLabel,
            p_vehicle_plate: "",
            p_photo_url: "",
            p_cover_url: "",
            p_description: bio,
            p_priority: 100,
            p_is_published: typeof isPublishedOverride === "boolean" ? isPublishedOverride : CURRENT_IS_PUBLISHED,
            p_is_active: true
          });'''

    new_rpc = '''          const token = driverSessionToken();
          if (!token){
            setAccessState(false, "session serveur absente");
            setFormDisabled(true);
            setMsgProfile("❌ Session serveur absente ou expirée. Repasse par la porte PIN.", "bad");
            return false;
          }

          const { data, error } = await sb.rpc("driver_session_save_profile", {
            p_token: token,
            p_business_name: displayName,
            p_driver_name: displayName,
            p_city: city,
            p_zones: zones,
            p_address: bridgeMeta,
            p_whatsapp: whatsapp,
            p_vehicle_type: vehicleType,
            p_vehicle_label: vehicleLabel,
            p_vehicle_plate: "",
            p_photo_url: "",
            p_cover_url: "",
            p_description: bio,
            p_priority: 100,
            p_is_published: typeof isPublishedOverride === "boolean" ? isPublishedOverride : CURRENT_IS_PUBLISHED,
            p_is_active: true
          });'''

    text = replace_once(
        text,
        old_rpc,
        new_rpc,
        "profile-edition.html/saveProfile RPC",
    )

    old_result = '''          if (error) throw error;
          if (!data?.ok) throw new Error(data?.reason || "save_profile_error");'''

    new_result = '''          if (error) throw error;
          if (!data?.ok){
            if (data?.reason === "invalid_or_expired_session"){
              setAccessState(false, "session expirée");
              setFormDisabled(true);
              setMsgProfile("❌ Session serveur expirée. Repasse par la porte PIN.", "bad");
              return false;
            }
            throw new Error(data?.reason || "save_profile_error");
          }'''

    text = replace_once(
        text,
        old_result,
        new_result,
        "profile-edition.html/saveProfile réponse",
    )

    old_fallback = '''          CURRENT_COCKPIT = null;
          CURRENT_IS_PUBLISHED = false;
          clearForm();'''

    new_fallback = '''          if (data?.reason === "invalid_or_expired_session"){
            CURRENT_COCKPIT = null;
            CURRENT_IS_PUBLISHED = false;
            setAccessState(false, "session expirée");
            clearForm();
            renderPublishState();
            setFormDisabled(true);
            setMsgProfile("❌ Session serveur expirée. Repasse par la porte PIN.", "bad");
            setMsgRates("❌ Session serveur expirée. Repasse par la porte PIN.", "bad");
            return false;
          }

          CURRENT_COCKPIT = null;
          CURRENT_IS_PUBLISHED = false;
          clearForm();'''

    text = replace_once(
        text,
        old_fallback,
        new_fallback,
        "profile-edition.html/fermeture session expirée",
    )

    checks = {
        "nouveau cockpit": 'sb.rpc("driver_session_get_cockpit"' in text,
        "nouvelle sauvegarde": 'sb.rpc("driver_session_save_profile"' in text,
        "ancien cockpit supprimé": 'sb.rpc("digiy_driver_get_cockpit_by_slug"' not in text,
        "ancienne sauvegarde supprimée": 'sb.rpc("digiy_driver_save_profile"' not in text,
        "token cockpit": 'p_token: token' in text,
    }
    failed = [name for name, ok in checks.items() if not ok]
    if failed:
        raise PatchError("Validation finale échouée : " + "; ".join(failed))

    backup = path.with_suffix(path.suffix + ".bak-driver-profile-session")
    shutil.copy2(path, backup)
    path.write_text(text, encoding="utf-8")

    print("PATCH PROFIL V3 APPLIQUÉ — aucun commit, aucun push.")
    print(f"Fichier modifié : {path}")
    print(f"Sauvegarde : {backup}")
    print("Cockpit et sauvegarde du profil utilisent maintenant la session serveur.")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except PatchError as exc:
        print(f"ERREUR PATCH V3 : {exc}", file=sys.stderr)
        raise SystemExit(1)
